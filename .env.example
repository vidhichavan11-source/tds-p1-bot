# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Any random string you pick -- used as a URL path secret so randoms
# can't hit your webhook endpoint. e.g. `python -c "import secrets;print(secrets.token_urlsafe(24))"`
TELEGRAM_WEBHOOK_SECRET=

# Public URL of your local Ollama, reachable from Render.
# e.g. a Cloudflare tunnel URL like https://your-tunnel.trycloudflare.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Fine-grained GitHub PAT with "Contents: Read and write" on GITHUB_REPO
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repo
GITHUB_BRANCH=main
LOG_PATH=logs/run.jsonl
